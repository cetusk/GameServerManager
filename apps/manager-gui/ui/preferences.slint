import { VerticalBox, HorizontalBox, ScrollView, CheckBox, AboutSlint, LineEdit } from "std-widgets.slint";
import { Theme, T, ActionButton, PageTab, ActivityIcon } from "components.slint";
export global AppPreferences {
    in-out property <bool> notify-completed: true;
    in-out property <bool> notify-failed: true;
    in-out property <bool> sound: false;
    in-out property <bool> remember-game: true;
    in-out property <bool> remember-tab: true;
    in property <string> steamcmd-path;
    in property <string> steamcmd-saved;
    in property <string> steamcmd-status;
    in property <string> steamcmd-phase;
    in property <bool> steamcmd-busy;
    in property <bool> steamcmd-supported;
    in property <bool> steamcmd-can-work;
    callback steamcmd-changed(string);
    callback steamcmd-browse(bool);
    callback steamcmd-apply(bool);
    callback steamcmd-default();
    in property <string> info;
    in property <string> data-path;
    in property <bool> data-can-change;
    callback change-data-directory();
    in property <string> transfer-summary;
    in property <bool> transfer-ready;
    in property <bool> transfer-busy;
    in property <bool> applying;
    callback changed();
    callback test-notification();
    callback export-settings();
    callback import-settings();
    callback apply-import();
    callback cancel-import();
}
export component PreferencesPage inherits Rectangle {
    background: Theme.background;
    private property <int> section: 0;
    VerticalBox {
        padding: 0px; spacing: 20px;
        Text { text: T.tr("アプリ設定", "App settings"); font-size: 26px; font-weight: 600; color: Theme.foreground; }
        Text { text: T.tr("表示・通知・保存先と共通ツールを設定します。", "Configure appearance, notifications, data location and shared tools."); color: Theme.muted; }
        HorizontalBox {
            padding: 0px; spacing: 0px;
            for title[index] in [T.tr("表示", "Appearance"), T.tr("通知", "Notifications"), T.tr("前回の記憶", "Remember"), T.tr("設定の移行", "Transfer"), T.tr("アプリ情報", "About"), T.tr("保存先", "Data location"), "SteamCMD"]: PageTab {
                text: title; selected: root.section == index; activated => { root.section = index; } navigate(delta) => { root.section = mod(root.section + delta + 7, 7); }
            }
        }
        ScrollView { VerticalBox {
            padding: 20px; spacing: 18px; alignment: start;
            if root.section == 0: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: T.tr("テーマカラー", "Theme color"); color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: T.tr("すべてダークモードです。変更はその場で反映されます。", "All themes use dark mode. Changes apply immediately."); color: Theme.muted; wrap: word-wrap; }
                HorizontalBox { padding: 0px; spacing: 14px;
                    for title[index] in [T.tr("ターコイズ", "Turquoise"), T.tr("ブルー", "Blue"), T.tr("バイオレット", "Violet")]: Rectangle {
                        height: 170px; border-radius: 10px; border-width: 1px;
                        border-color: Theme.palette == index ? Theme.accent : Theme.border; background: Theme.surface;
                        VerticalBox { padding: 16px; spacing: 16px;
                            Rectangle { height: 65px; border-radius: 6px; background: Theme.background;
                                Rectangle { x: 12px; y: 16px; width: parent.width - 24px; height: 8px; border-radius: 4px; background: index == 1 ? #78b4ff : index == 2 ? #bb9af7 : #56d7c3; }
                                Rectangle { x: 12px; y: 36px; width: parent.width - 55px; height: 5px; border-radius: 3px; background: Theme.border; }
                            }
                            ActionButton { enabled: !AppPreferences.applying; text: title; primary: Theme.palette == index; activated => { Theme.palette = index; AppPreferences.changed(); } }
                        }
                    }
                }

            }
            if root.section == 1: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: T.tr("画面内の作業通知", "In-app job notifications"); color: Theme.foreground; font-size: 16px; font-weight: 600; }
                CheckBox { enabled: !AppPreferences.applying; text: T.tr("作業完了を通知", "Notify when a job completes"); checked <=> AppPreferences.notify-completed; toggled => { AppPreferences.changed(); } }
                CheckBox { enabled: !AppPreferences.applying; text: T.tr("作業失敗を通知", "Notify when a job fails"); checked <=> AppPreferences.notify-failed; toggled => { AppPreferences.changed(); } }
                CheckBox { enabled: !AppPreferences.applying; text: T.tr("通知音（Windows のシステム音）", "Notification sound (Windows system sound)"); checked <=> AppPreferences.sound; toggled => { AppPreferences.changed(); } }
                Text { text: T.tr("通知をオフにしても作業履歴は記録されます。", "Job history is recorded even when notifications are off."); color: Theme.muted; wrap: word-wrap; }
                ActionButton { text: T.tr("通知を試す", "Test notification"); activated => { AppPreferences.test-notification(); } }
            }
            if root.section == 2: VerticalBox {
                padding: 0px; spacing: 16px;
                CheckBox { enabled: !AppPreferences.applying; text: T.tr("前回のゲームを開く", "Remember the last game"); checked <=> AppPreferences.remember-game; toggled => { AppPreferences.changed(); } }
                CheckBox { enabled: !AppPreferences.applying; text: T.tr("前回のタブを開く", "Remember the last tab"); checked <=> AppPreferences.remember-tab; toggled => { AppPreferences.changed(); } }
                Text { text: T.tr("記憶するのは表示画面だけです。サーバーを自動起動したり、実行中の作業を再開したりはしません。", "Only navigation is remembered. Servers and jobs are never started automatically."); color: Theme.muted; wrap: word-wrap; }
            }
            if root.section == 3: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: T.tr("アプリ設定のエクスポート／インポート", "Export / import app settings"); color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: T.tr("テーマ・言語・通知・前回の記憶を移行します。サーバーの登録やパスワード、ワールドデータは含みません。", "Transfer theme, language, notifications and navigation preferences. Server registrations, passwords and world data are excluded."); color: Theme.muted; wrap: word-wrap; }
                ActionButton { text: T.tr("設定をエクスポート", "Export settings"); icon: "download"; enabled: !AppPreferences.transfer-busy; activated => { AppPreferences.export-settings(); } }
                ActionButton { text: T.tr("設定ファイルを選択", "Choose settings file"); icon: "folder"; enabled: !AppPreferences.transfer-busy; activated => { AppPreferences.import-settings(); } }
                if AppPreferences.transfer-busy: Text { text: T.tr("設定ファイルを処理中…", "Processing settings file…"); color: Theme.accent; }
                if AppPreferences.transfer-summary != "": Text { text: AppPreferences.transfer-summary; color: Theme.foreground; wrap: word-wrap; }
                if AppPreferences.transfer-ready: HorizontalBox {
                    padding: 0px;
                    ActionButton { enabled: !AppPreferences.transfer-busy; text: T.tr("キャンセル", "Cancel"); activated => { AppPreferences.cancel-import(); } }
                    ActionButton { enabled: !AppPreferences.transfer-busy; text: T.tr("この設定を適用", "Apply these settings"); primary: true; activated => { AppPreferences.apply-import(); } }
                }
            }
            if root.section == 6: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: T.tr("SteamCMD の共通設定", "Shared SteamCMD settings"); color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: T.tr("SteamCMD はゲームサーバーの更新・インストール用ツールです。通常の Steam とは別で、複数のゲームで共用できます。", "SteamCMD installs and updates game servers. It is separate from the Steam client and can be shared by multiple games."); color: Theme.muted; wrap: word-wrap; }
                Text { text: T.tr("新しいサーバー設定では、このパスを初期入力します。各ゲームの SteamCMD 欄で個別に変更できます。既存のサーバー設定は上書きしません。", "New server configurations start with this path. Each game's SteamCMD field can override it. Existing server configurations remain unchanged."); color: Theme.muted; wrap: word-wrap; }
                Text { text: T.tr("SteamCMD 実行ファイル（絶対パス）", "SteamCMD executable (absolute path)"); color: Theme.foreground; }
                LineEdit { text: AppPreferences.steamcmd-path; enabled: !AppPreferences.steamcmd-busy;
                    edited(value) => { AppPreferences.steamcmd-changed(value); }
                }
                HorizontalBox { padding: 0px; spacing: 10px;
                    ActionButton { text: T.tr("既存の exe を選ぶ", "Choose existing EXE"); icon: "folder"; enabled: !AppPreferences.steamcmd-busy; activated => { AppPreferences.steamcmd-browse(true); } }
                    ActionButton { text: T.tr("配置フォルダーを選ぶ", "Choose install folder"); icon: "folder"; enabled: !AppPreferences.steamcmd-busy; activated => { AppPreferences.steamcmd-browse(false); } }
                    ActionButton { text: T.tr("既定候補に戻す", "Reset suggested path"); enabled: !AppPreferences.steamcmd-busy; activated => { AppPreferences.steamcmd-default(); } }
                }
                Text { text: T.tr("既定候補は C:\\steamcmd\\steamcmd.exe です。書き込み可能な別の場所にも変更できます。ダウンロードには空のフォルダーを指定してください。", "Suggested path: C:\\steamcmd\\steamcmd.exe. You can choose another writable location. Downloads require an empty folder."); color: Theme.muted; wrap: word-wrap; }
                Text { text: T.tr("Valve の配布元から ZIP をダウンロードし、展開後に共通パスを保存します。既存ファイルは上書きしません。SteamCMD の初回自己更新はゲームサーバーの更新・インストール時に実行されます。", "Downloads the ZIP from Valve, extracts it and saves the shared path. Existing files are never overwritten. SteamCMD initializes and updates itself when you first install or update a game server."); color: Theme.muted; wrap: word-wrap; }
                Text { text: "https://steamcdn-a.akamaihd.net/client/installer/steamcmd.zip"; color: Theme.muted; wrap: word-wrap; }
                HorizontalBox { padding: 0px; spacing: 10px;
                    ActionButton { text: T.tr("このパスを保存", "Save this path"); enabled: AppPreferences.steamcmd-can-work; activated => { AppPreferences.steamcmd-apply(false); } }
                    ActionButton { text: T.tr("ダウンロードして設定", "Download and configure"); icon: "download"; primary: true; enabled: AppPreferences.steamcmd-can-work; activated => { AppPreferences.steamcmd-apply(true); } }
                }
                if AppPreferences.steamcmd-saved != "": Text { text: T.tr("保存済みの共通パス: ", "Saved shared path: ") + AppPreferences.steamcmd-saved; color: Theme.muted; wrap: word-wrap; }
                if AppPreferences.steamcmd-status != "": HorizontalBox { padding: 0px; spacing: 8px;
                    ActivityIcon { phase: AppPreferences.steamcmd-phase; }
                    Text { text: AppPreferences.steamcmd-status; color: AppPreferences.steamcmd-phase == "failed" ? #ff9daa : Theme.foreground; wrap: word-wrap; }
                }
                if !AppPreferences.steamcmd-supported: Text { text: T.tr("ダウンロードと保存は Windows の実管理モードで利用できます。", "Download and save are available in local management mode on Windows."); color: Theme.muted; wrap: word-wrap; }
                if AppPreferences.steamcmd-supported && !AppPreferences.steamcmd-can-work && !AppPreferences.steamcmd-busy: Text { text: T.tr("サーバーの操作や設定登録が完了してから実行してください。", "Wait for server operations and registration to finish."); color: Theme.muted; wrap: word-wrap; }
            }
            if root.section == 5: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: T.tr("管理データの保存先", "Management data directory"); color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: AppPreferences.data-path; color: Theme.foreground; wrap: word-wrap; }
                Text { text: T.tr("ゲームの登録情報・アプリ設定・作業記録を保存する場所です。ゲーム本体・ワールド・バックアップの保存先はサーバー設定で変更します。", "Stores server registrations, app preferences and operation records. Change game, world and backup paths in Server settings."); color: Theme.muted; wrap: word-wrap; }
                Text { text: T.tr("保存先を選ぶ画面へ移ります。選択後はそのフォルダーの管理データで画面を開き直します。元のデータは移動・削除しません。", "Opens the directory chooser, then reopens the manager with that directory's data. Original data is never moved or deleted."); color: Theme.muted; wrap: word-wrap; }
                ActionButton { text: T.tr("保存先を選ぶ…", "Choose data directory…"); icon: "folder"; enabled: AppPreferences.data-can-change; activated => { AppPreferences.change-data-directory(); } }
                if !AppPreferences.data-can-change: Text { text: T.tr("すべてのサーバーの停止と、実行中の作業の完了を確認してから変更できます。状態不明の場合も先に確認してください。", "Stop all servers and wait for jobs to finish before changing this location. Unknown server states must also be resolved first."); color: Theme.muted; wrap: word-wrap; }
            }
            if root.section == 4: VerticalBox {
                padding: 0px; spacing: 16px;
                Text { text: "GameServerManager"; color: Theme.foreground; font-size: 16px; font-weight: 600; }
                Text { text: T.tr("ゲームサーバー統合管理ツール", "Unified Game Server Management Tool"); color: Theme.muted; wrap: word-wrap; }
                Text { text: AppPreferences.info; color: Theme.muted; wrap: word-wrap; }
                Text { text: "MIT License · Copyright (c) 2026 cetusk"; color: Theme.muted; wrap: word-wrap; }
                HorizontalBox { padding: 0px; alignment: start;
                    AboutSlint { width: 220px; height: 132px; horizontal-stretch: 0; vertical-stretch: 0; }
                }
            }
        } }
    }
}
